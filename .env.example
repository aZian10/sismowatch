# ==============================================================================
# SismoWatch Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env file or sensitive keys into version control.

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=sismowatch
POSTGRES_USER=sismowatch_admin
POSTGRES_PASSWORD=sismowatch_secure_pass_2026
POSTGRES_APP_USER=sismowatch_app
POSTGRES_APP_PASSWORD=sismowatch_app_pass_2026

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin_sismowatch_2026
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqnzq8=
AIRFLOW__CORE__SECRET_KEY=sismowatch_airflow_super_secret_webserver_key_2026
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False

# Backend Security & JWT
JWT_SECRET_KEY=sismowatch_jwt_super_secret_signing_key_change_in_production_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seed Administrator Account (Auto-provisioned on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecure2026!
ADMIN_EMAIL=admin@sismowatch.internal
ADMIN_FULL_NAME=System Administrator

# Seed Viewer Account (Auto-provisioned on startup)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=ViewerSecure2026!
VIEWER_EMAIL=viewer@sismowatch.internal
VIEWER_FULL_NAME=Risk Analyst Viewer

# LLM Configuration (supports 'openai', 'gemini', 'anthropic', or 'mock'/'deterministic')
LLM_PROVIDER=deterministic
LLM_MODEL=deterministic-v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=15

# URLs and Ports
API_PORT=8000
WEB_PORT=5173
AIRFLOW_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
